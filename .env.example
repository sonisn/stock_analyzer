# =============================================================================
# stock-analyzer environment variables
# =============================================================================
# Copy this file to `.env` and fill in your values.
# `.env` is gitignored — secrets stay local.

# -----------------------------------------------------------------------------
# LLM providers
# -----------------------------------------------------------------------------
# Claude API key — required if you use any "claude" provider role.
# Console: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Gemini API key — required if you use any "gemini" provider role.
# Console: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=

# OpenAI API key — required if you use any "openai" provider role (e.g. a
# ranker consensus round, or DISCOVER_REDTEAM_PROVIDER/DISCOVER_FALLBACK_PROVIDER).
# Console: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# -----------------------------------------------------------------------------
# Model selection
# -----------------------------------------------------------------------------
# Default provider + model used by every agent (sentiment, ticker, rerank,
# insider). Change these two vars to swap models everywhere. No code change.
#
#   Examples:
#     LLM_PROVIDER=claude   LLM_MODEL=claude-haiku-4-5     (cheap, fast)
#     LLM_PROVIDER=claude   LLM_MODEL=claude-sonnet-4-6    (smarter, pricier)
#     LLM_PROVIDER=gemini   LLM_MODEL=gemini-pro-latest
LLM_PROVIDER=claude
LLM_MODEL=claude-haiku-4-5

# Optional per-role overrides — leave blank to use LLM_PROVIDER/LLM_MODEL.
# Useful for mixing: e.g. cheap Haiku for ticker blocks, smarter Sonnet for
# the macro sentiment synthesis.
SENTIMENT_PROVIDER=
SENTIMENT_MODEL=
TICKER_PROVIDER=
TICKER_MODEL=
RERANK_PROVIDER=
RERANK_MODEL=
INSIDER_PROVIDER=
INSIDER_MODEL=

# -----------------------------------------------------------------------------
# Data sources
# -----------------------------------------------------------------------------
# Tavily search API — powers macro-sentiment news and insider/political
# trade coverage. Free tier ~1000 searches/month.
# Sign up: https://tavily.com
TAVILY_API_KEY=

# chart-img.com — renders TradingView-style chart PNGs (used to embed
# per-holding charts in the portfolio digest email).
# Dashboard: https://chart-img.com/
CHART_IMG_API_KEY=

# SnapTrade — aggregates holdings across your connected brokerages.
# Dashboard: https://snaptrade.com/dashboard
# CLIENT_ID + CONSUMER_KEY come from the SnapTrade dashboard.
# USER_ID + USER_SECRET are returned the first time you register a user
# via the SDK (one-time per user). Persist them and reuse on every run.
SNAPTRADE_CLIENT_ID=
SNAPTRADE_CONSUMER_KEY=
SNAPTRADE_USER_ID=
SNAPTRADE_USER_SECRET=

# -----------------------------------------------------------------------------
# Email delivery (SMTP)
# -----------------------------------------------------------------------------
# Host of your SMTP provider, e.g. smtp.gmail.com or smtp.fastmail.com
SMTP_HOST=

# 465 for SSL (recommended), 587 for STARTTLS.
SMTP_PORT=465

# "true" → SSL on 465; "false" → STARTTLS on 587.
SMTP_USE_SSL=true

# Full SMTP login (usually your email address).
SMTP_USERNAME=

# App-specific password if 2FA is on (required by Gmail / Outlook / iCloud).
SMTP_PASSWORD=

# Display "From" address. Leave blank to default to SMTP_USERNAME.
SMTP_FROM=

# Recipient for analysis emails (you).
EMAIL_TO=

# -----------------------------------------------------------------------------
# Behavior (optional — defaults shown)
# -----------------------------------------------------------------------------
# Log verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Directory where rotating log files are written. Default lives under your
# home dir; override if you want to centralize logs elsewhere (e.g. a
# host-mounted volume in containerized runs).
LOG_DIR=~/.stock_analyzer/logs

# Specific log file path. When set, overrides LOG_DIR's auto-naming and
# writes every run to this single file. Leave blank to get one timestamped
# file per run under LOG_DIR.
LOG_FILE=

# Directory where rebalance/discover PDFs are persisted locally before
# the SMTP attempt. A delivery failure never costs you the report — the
# PDF is always saved here.
REPORTS_DIR=~/.stock_analyzer/reports

# Days to look back when fetching insider + political trade coverage.
INSIDER_LOOKBACK_DAYS=5

# -----------------------------------------------------------------------------
# Discover pipeline (cli/discover.py) — find new stocks worth buying
# -----------------------------------------------------------------------------
# Run via: python -m stock_analyzer.cli.discover
#
# Models per stage. Opus runs sizing, plus the "claude" round of ranking
# (see DISCOVER_RANKER_PROVIDERS below) — the ranker and red-team stages
# are no longer Opus-only; how they're split across providers is
# controlled further down. Sonnet runs per-candidate analysis and market
# themes. Override if needed.
DISCOVER_OPUS_MODEL=claude-opus-4-7
DISCOVER_SONNET_MODEL=claude-sonnet-4-6

# Optional watchlist of tickers to always include in the universe (CSV).
DISCOVER_WATCHLIST=

# Cash budget for position sizing in dollars. If unset, sizer outputs
# percentages of available capital instead of dollar amounts.
DISCOVER_CASH_BUDGET=
# Hard sector caps enforced after the Sizer (percent). With a cash budget,
# a sector may not exceed DISCOVER_MAX_SECTOR_PCT of holdings + new money;
# it may never take more than DISCOVER_MAX_SECTOR_NEW_PCT of new capital.
DISCOVER_MAX_SECTOR_PCT=30
DISCOVER_MAX_SECTOR_NEW_PCT=50
# Rebalance: flag taxable positions for tax-loss harvesting when the
# unrealized loss is at least this many dollars and this percent.
HARVEST_MIN_LOSS_USD=1000
HARVEST_MIN_LOSS_PCT=10
# Per-run cap on estimated LLM spend in USD (blank = no cap). Cheaper
# options are used first; a call that would pass the cap is refused.
DISCOVER_MAX_COST_USD=
# Prices for non-Claude models so they count toward the cap, as
# model=input:output USD per million tokens, comma-separated.
LLM_PRICES=
# History upkeep, run at the end of every discover/rebalance run and in the
# monthly model-review: adds backfilled pick fields + outcome labels, trims
# LLM prose older than TEXT days, agno step logs older than SESSION days,
# failed-screen candidates older than CANDIDATE days, model versions beyond
# the newest KEEP (accepted ones stay), and app log/cache files older than
# FILE days. Analysis rows (picks, scores, outcomes, verdicts) are never deleted.
HISTORY_UPKEEP=true
HISTORY_TEXT_RETENTION_DAYS=365
HISTORY_SESSION_RETENTION_DAYS=30
HISTORY_CANDIDATE_RETENTION_DAYS=540
HISTORY_KEEP_MODEL_VERSIONS=12
HISTORY_FILE_RETENTION_DAYS=30

# Where to persist run history (SQLite). The discover.db file holds BOTH our
# domain tables (runs/picks/candidates) AND Agno Workflow's session log —
# single file, two table sets. Reports are delivered via email (EMAIL_TO /
# SMTP_*) — no file written to disk.
DISCOVER_DB_PATH=~/.stock_analyzer/discover.db

# Ranker consensus voting: one round per (provider, model) pair below, each
# a full high-effort ranking pass; a ticker is kept if a majority of rounds
# pick it. Three providers means real cross-model disagreement (different
# training data, different blind spots) instead of one model's own sampling
# stochasticity — the previous DISCOVER_CONSENSUS_RUNS=N behavior (resample
# one Claude agent N times) is still available: set DISCOVER_RANKER_PROVIDERS
# to "claude,claude,claude" (or fewer) to get it back.
#
# DISCOVER_RANKER_MODELS is optional and positionally paired with
# DISCOVER_RANKER_PROVIDERS — leave an entry blank (or the whole var empty)
# to use that provider's default model (DISCOVER_OPUS_MODEL for claude,
# DISCOVER_GEMINI_MODEL/DISCOVER_OPENAI_MODEL for the others).
#
# This is the most expensive stage in the pipeline (high reasoning effort,
# 16k max output tokens, every analyst report in the prompt) — 3 rounds
# means 3x the cost of a single-round run, split across 3 providers'
# billing instead of one.
DISCOVER_RANKER_PROVIDERS=claude,gemini,openai
DISCOVER_RANKER_MODELS=
# DISCOVER_GEMINI_MODEL defaults to the "-latest" alias rather than a
# pinned version — a hand-picked version string (e.g. "gemini-3-pro")
# broke in production with a 404 the day this was written, because it
# doesn't exist; Google renames/retires dated model ids often enough that
# pinning one here is a real ongoing maintenance burden. The alias always
# resolves to Google's current best model in this tier, at the cost of
# not knowing in advance which exact model will run. Pin to a specific
# version instead only if you need reproducibility across runs badly
# enough to accept it breaking again someday.
DISCOVER_GEMINI_MODEL=gemini-pro-latest
# No equivalent "-latest" alias exists for OpenAI; confirm this model id
# is available on your account before relying on it.
DISCOVER_OPENAI_MODEL=gpt-6-astra

# Red-team critiques the ranker's winning picks looking for reasons NOT to
# buy. Defaults to a different provider than the primary Claude pipeline so
# the critique isn't checking a model's own blind spots.
DISCOVER_REDTEAM_PROVIDER=gemini
DISCOVER_REDTEAM_MODEL=

# If a stage's primary provider call fails (auth/rate-limit/provider error),
# retry once on this provider instead of failing the whole run.
DISCOVER_FALLBACK_PROVIDER=claude
DISCOVER_FALLBACK_MODEL=

# Sampling frame for the discover pipeline — the names that are ELIGIBLE to
# be picked, before any filtering. Defaults to the bundled S&P 500 snapshot
# (src/stock_analyzer/data/static/sp500_constituents.txt) plus your
# watchlist and current holdings; the insider/hedge-fund news feeds add a
# conviction signal on top but are no longer the candidate pool itself.
#
# Point this at your own newline-delimited ticker list to screen a
# different frame (# comments allowed). A larger frame means more yfinance
# fetches (~500 names is a few minutes); it does NOT increase LLM cost,
# which is capped at 25 candidates regardless.
# DISCOVER_UNIVERSE_FILE=~/my_universe.txt

# Rebalance aggressiveness — controls how willing the rebalancer is to
# recommend SELL/TRIM/ADD actions that incur tax friction.
#
#   conservative — strict tax-after-EV bar (10%). Forward deterioration
#                  required for any SELL/TRIM. Default until 2026-05.
#   balanced     — risk-reduction trims allowed on overbought (weekly RSI
#                  > 80) + above-target positions, even with short-term
#                  tax cost. 5% post-tax bar. (Recommended default.)
#   aggressive   — tax-aware but not tax-blocked. Recommend churn where
#                  forward signal is meaningfully better. 0% post-tax bar.
#
# The report ALWAYS includes a "Tax-agnostic alternative" section in any
# NO ACTION output, so you see opportunity cost regardless of mode.
DISCOVER_REBALANCE_AGGRESSIVENESS=balanced

# -----------------------------------------------------------------------------
# Macro data (used by discover ranker prompt for regime awareness)
# -----------------------------------------------------------------------------
# FRED API key (St. Louis Fed) — free, instant signup.
# Register: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Finnhub API key — free tier covers earnings surprises, analyst
# recommendation trend, price targets, and Form 4 insider transactions.
# Free tier: 60 calls/min, US equities only.
# Register: https://finnhub.io/register
FINNHUB_API_KEY=

# Reuse cached report when present. Caching is disabled in cli/* by
# default — flip the cache code on first if you want this honored.
USE_CACHED_ANALYSIS=1

# -----------------------------------------------------------------------------
# Covered-call writing (optional) — used by cli/rebalance.py
# -----------------------------------------------------------------------------
# Master switch. Set to 0 to disable all CC logic (eligibility, chain
# fetch, rebalancer prompt section). Pipeline runs as before.
CC_ENABLED=1

# Strike selection band (Δ). The Opus rebalancer picks strikes within
# [min, max], leaning toward MIN on high-confidence HOLDs and toward
# MAX on TRIM/low-confidence positions. Defaults are "aggressive
# premium" style — Δ 0.35-0.45 ≈ real chance of assignment.
CC_TARGET_DELTA_MIN=0.35
CC_TARGET_DELTA_MAX=0.45

# Days-to-expiry band. 30-45 DTE = 1 cycle/month, decent theta decay,
# below the long-dated tax-treatment cliff.
CC_DTE_MIN=30
CC_DTE_MAX=45

# Tickers to never write options on — covered calls OR cash-secured
# puts (comma-separated). CC_DENYLIST, the old name, is still read.
OPTIONS_DENYLIST=

# If expected total premium across all WRITE_CALLs is less than this
# (USD), the rebalancer leaves the premium as cash rather than
# proposing reinvestment trades (avoids friction for tiny premiums).
CC_MIN_PREMIUM_USD=500

# Fraction of expected premium held back when sizing reinvestment
# trades, to account for fill slippage vs. mid-quote estimates.
CC_SLIPPAGE_BUFFER=0.10

# Stub consolidation: sell sub-100 "stub" shares to fund round-lot
# completion elsewhere (expanding future CC capacity). Set 0 to
# disable.
CC_STUB_OPTIMIZATION=1

# Don't propose stub consolidation when the stub is worth less than
# this (USD) — trade friction wastes the gain.
CC_MIN_STUB_USD=1000

# -----------------------------------------------------------------------------
# Cash-secured puts (optional) — used by cli/rebalance.py
# -----------------------------------------------------------------------------
# Sell puts on recent discover picks you don't hold yet (the front half
# of the "wheel"): you're paid to wait, and only buy if the stock drops
# below the strike. Set to 0 to disable.
CSP_ENABLED=1

# Premium-harvest band: low delta (|Δ| 0.10-0.25 ≈ 10-25% assignment
# odds), 30-45 days to expiry.
CSP_TARGET_DELTA_MIN=0.10
CSP_TARGET_DELTA_MAX=0.25
CSP_DTE_MIN=30
CSP_DTE_MAX=45

# Collateral caps as fractions of available cash: one put's strike ×
# 100 × contracts, and all puts together. Enforced after the LLM answers.
CSP_MAX_PCT_PER_PUT=0.25
CSP_MAX_PCT_TOTAL=0.80

# Picks from this many past runs (plus the current one) are candidates.
CSP_PICK_LOOKBACK_RUNS=3

# -----------------------------------------------------------------------------
# Tradier options data (primary chain provider for covered-call writing)
# -----------------------------------------------------------------------------
# Tradier brokerage API token — gives real-time options chain data WITH
# Greeks (delta, gamma, theta, vega, IV). The CC pipeline uses this as
# the primary chain source; yfinance is the fallback when the key is
# unset or Tradier is unreachable.
#
# Free path to real-time data: open a Tradier brokerage account (no
# funding minimum) at https://tradier.com/signup, then generate an
# access token at https://dash.tradier.com/.
TRADIER_API_KEY=

# Production URL: https://api.tradier.com/v1   (real-time, requires
#                                              brokerage account token)
# Sandbox URL:    https://sandbox.tradier.com/v1   (15-min delayed)
TRADIER_BASE_URL=https://api.tradier.com/v1

# -----------------------------------------------------------------------------
# Request pacing (yfinance + Finnhub)
# -----------------------------------------------------------------------------
# Yahoo publishes no quota but throttles hard: sustained bursts come back
# as "Too Many Requests" and whole pipeline steps return empty. Every
# yfinance call in the codebase goes through data/yf_gateway.py, which
# enforces these process-wide across all steps and thread pools, halves
# its own rate on a 429, and walks it back up as calls succeed. The
# end-of-run "yfinance [discover run]: ..." log line reports what the
# run actually used — read it before changing anything here.

# Max in-flight Yahoo requests for the whole process.
YF_MAX_CONCURRENCY=4

# Starting (and ceiling) request rate. The pacer never exceeds this.
YF_RATE_LIMIT_PER_MIN=150

# Floor the backoff stops at after repeated rate limits.
YF_MIN_RATE_PER_MIN=20

# Tries per call before giving up (rate limits only; a 404 is never retried).
YF_MAX_ATTEMPTS=4

# Base pause applied to EVERY worker after a rate limit; doubles per
# consecutive limit, capped at 120s.
YF_COOLDOWN_SECONDS=15

# Fan-out width a single batch helper may use (still bounded by
# YF_MAX_CONCURRENCY above).
YF_BATCH_WORKERS=8

# Seconds a cached yf.Ticker (and its memoized `info`) stays valid.
YF_TICKER_CACHE_TTL=1800

# Finnhub free tier is 60 calls/min per key. Paid tiers raise it.
FINNHUB_RATE_LIMIT_PER_MIN=55
FINNHUB_MAX_ATTEMPTS=3
FINNHUB_COOLDOWN_SECONDS=10

# -----------------------------------------------------------------------------
# Screen funnel width
# -----------------------------------------------------------------------------
# After technicals, names that fail the hard filter's trend rules are
# dropped before the expensive per-ticker fetches (fundamentals + EPS
# revisions, ~3 Yahoo requests each). This caps how many survivors go on
# to those fetches, ranked by 6-month relative strength. Holdings and
# watchlist names are never capped out.
DISCOVER_MAX_SCREEN_CANDIDATES=250
